APP_NAME=SIGPS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

# ==========================================
# BASE DE DATOS
# ==========================================
# Opción 1: PostgreSQL 16 (Contenedor 'postgres' de docker-compose.dev.yml)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=sigps
DB_USERNAME=sigps
DB_PASSWORD=secret

# Opción 2: SQLite (No requiere contenedor de base de datos)
# DB_CONNECTION=sqlite

# ==========================================
# SESIONES, COLAS Y CACHÉ
# ==========================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false

QUEUE_CONNECTION=database
CACHE_STORE=database

# Configuración de Redis en Docker (si se utiliza para cache o colas)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ==========================================
# CORREO ELECTRÓNICO (MAILPIT)
# ==========================================
# Captura correos en http://localhost:8025
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@sigps.local"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================
# VITE
# ==========================================
VITE_APP_NAME="${APP_NAME}"
